<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para CardViews redondeados -->
    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Estilo para imágenes redondeadas -->
    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Estilo para botones de acción -->
    <style name="ActionButtonStyle" parent="Widget.MaterialComponents.Button.Icon">
        <item name="android:background">@drawable/button_rounded</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">4dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Estilo para el drag handle -->
    <style name="DragHandleStyle">
        <item name="android:src">@drawable/ic_drag_handle</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Estilo para el indicador de reproducción -->
    <style name="PlayingIndicatorStyle">
        <item name="android:src">@drawable/ic_playing_indicator</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">@drawable/playing_indicator_bg</item>
    </style>
</resources>