<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mini_player_container"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@android:color/white"
    android:elevation="12dp"
    android:paddingHorizontal="8dp">

    <ProgressBar
        android:id="@+id/pb_mini_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="30"
        android:progressDrawable="@drawable/mini_player_progress_drawable"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_mini_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_mini_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note_24"
            android:contentDescription="@string/song_cover" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toEndOf="@id/cv_mini_art"
        app:layout_constraintEnd_toStartOf="@id/btn_previous_mini"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/black"
            tools:text="Song Title" />

        <TextView
            android:id="@+id/tv_mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:alpha="0.8"
            tools:text="Artist Name" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_previous_mini"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_skip_previous_24"
        android:contentDescription="Anterior"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toStartOf="@id/btn_play_mini"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btn_play_mini"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_play_arrow_24"
        android:contentDescription="@string/play_pause"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toStartOf="@id/btn_next_mini"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btn_next_mini"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_skip_next_24"
        android:contentDescription="Siguiente"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toStartOf="@id/btn_queue_mini"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btn_queue_mini"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_queue_music_24"
        android:contentDescription="Cola"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_mini_progress"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
