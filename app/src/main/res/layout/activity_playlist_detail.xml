<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Playlist"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleTextColor="@color/on_background" />

    <!-- Info de la playlist -->
    <TextView
        android:id="@+id/tv_song_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="0 canciones"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/on_background_variant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Botones de acción -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_play_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Reproducir todas"
        style="@style/Widget.Hush.Button.Pill"
        app:icon="@drawable/ic_play_arrow_24"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toStartOf="@id/btn_add_song"
        app:layout_constraintTop_toTopOf="@id/tv_song_count"
        app:layout_constraintBottom_toBottomOf="@id/tv_song_count" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_song"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Agregar"
        style="@style/Widget.Hush.Button.Pill"
        app:icon="@drawable/ic_add_24"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_song_count"
        app:layout_constraintBottom_toBottomOf="@id/tv_song_count" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlist_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_song_count"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty_songs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay canciones en esta playlist"
        android:textSize="18sp"
        android:textColor="@color/on_background_variant"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>