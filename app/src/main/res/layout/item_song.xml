<?xml version="1.0" encoding="utf-8"?>
<!--
    item_song.xml
    Fila de canción para la Biblioteca y la Cola.
    - Thumb circular de color aleatorio con ícono de nota
    - Título + artista
    - Duración
    Cuando la canción está activa, el fondo se pinta con @color/item_active_bg
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_song_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Checkbox (visible solo en modo selección) -->
    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Thumb circular con color de fondo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/thumb_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cb_select"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_note"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Nota musical"
            app:srcCompat="@drawable/ic_music_note_24"
            app:tint="@color/white" />
    </androidx.cardview.widget.CardView>

    <!-- Título de la canción -->
    <TextView
        android:id="@+id/tv_song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/on_background"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_duration"
        app:layout_constraintStart_toEndOf="@id/card_thumb"
        app:layout_constraintTop_toTopOf="@id/card_thumb"
        tools:text="Blinding Lights" />

    <!-- Artista -->
    <TextView
        android:id="@+id/tv_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/on_background_variant"
        app:layout_constraintBottom_toBottomOf="@id/card_thumb"
        app:layout_constraintEnd_toStartOf="@id/tv_duration"
        app:layout_constraintStart_toEndOf="@id/card_thumb"
        app:layout_constraintTop_toBottomOf="@id/tv_song_title"
        tools:text="The Weeknd" />

    <!-- Duración -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/on_background_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_menu"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3:22" />

    <!-- Botón menú 3 puntos -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Más opciones"
        app:srcCompat="@drawable/ic_more_vert_24"
        app:tint="@color/on_background_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
