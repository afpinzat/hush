<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_queue_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_small"
    android:paddingStart="@dimen/spacing_large"
    android:paddingEnd="@dimen/spacing_medium"
    android:minHeight="@dimen/height_queue_item"
    android:background="?attr/selectableItemBackground">

    <!-- Handle para arrastrar -->
    <ImageView
        android:id="@+id/iv_drag_handle"
        android:layout_width="@dimen/icon_medium"
        android:layout_height="@dimen/icon_medium"
        android:src="@drawable/ic_drag_handle"
        android:padding="4dp"
        android:background="?attr/selectableItemBackground"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Thumbnail circular -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_thumb"
        android:layout_width="@dimen/icon_large"
        android:layout_height="@dimen/icon_large"
        android:layout_marginStart="@dimen/spacing_small"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/iv_drag_handle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♪"
            android:textSize="@dimen/text_title"
            android:textColor="@color/white"
            android:fontFamily="sans-serif" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Título de la canción -->
    <TextView
        android:id="@+id/tv_song_title"
        style="@style/TextAppearance.Material3.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/card_thumb"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_duration"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_small" />

    <!-- Artista -->
    <TextView
        android:id="@+id/tv_artist"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tv_song_title"
        app:layout_constraintTop_toBottomOf="@id/tv_song_title"
        app:layout_constraintEnd_toStartOf="@id/tv_duration" />

    <!-- Duración -->
    <TextView
        android:id="@+id/tv_duration"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toStartOf="@id/btn_remove"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/spacing_small" />

    <!-- Botón eliminar -->
    <ImageView
        android:id="@+id/btn_remove"
        android:layout_width="@dimen/icon_medium"
        android:layout_height="@dimen/icon_medium"
        android:src="@drawable/ic_remove"
        android:padding="@dimen/spacing_small"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Indicador de reproducción -->
    <ImageView
        android:id="@+id/iv_playing_indicator"
        android:layout_width="@dimen/icon_medium"
        android:layout_height="@dimen/icon_medium"
        android:src="@drawable/ic_playing"
        android:visibility="gone"
        android:scaleType="center"
        android:background="@drawable/playing_indicator_bg"
        app:layout_constraintStart_toStartOf="@id/card_thumb"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/icon_large" />

</androidx.constraintlayout.widget.ConstraintLayout>